{
  "name": "sap-cap-inventory-fiori",
  "version": "1.0.0",
  "description": "Portal de Compras e Inventario estilo SAP MM/Fiori desarrollado con SAP CAP (Node.js), SQLite y OpenUI5.",
  "scripts": {
    "start": "cds-serve",
    "dev": "cds watch",
    "deploy": "cds deploy --to sqlite:db.sqlite"
  },
  "dependencies": {
    "@cap-js/sqlite": "^3.0.0",
    "@sap/cds": "^10.0.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@sap/cds-dk": "^10.0.0"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite"
      }
    }
  }
}
